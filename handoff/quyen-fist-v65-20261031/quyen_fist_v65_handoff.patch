+	var caster: Dictionary = battle.actors[str(actor.id)]
+	var enemy: Dictionary = battle.actors[str(target.id)]
+	var hp_before := float(enemy.hp)
+	if not _check(V63HumanSkillCombatSystem.try_cast(battle, caster, enemy), "in-range attack did not start for revalidation fixture"):
+		return false
+	var pending: Dictionary = caster.get("v63_pending_cast", {})
+	enemy["position"] = Vector2(30.0, 8.0)
+	battle.now = float(pending.get("ready", 0.0))
