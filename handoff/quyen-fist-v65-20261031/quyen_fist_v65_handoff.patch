+func _test_modifiers(row: Dictionary, actor: Dictionary) -> bool:
+	var id := str(row.get("id", ""))
+	var modifiers: Dictionary = row.get("passive_modifiers", {})
+	var attack := V63HumanSkillCombatSystem.effective_attack_stats(actor, actor.stats)
+	var expected_factor := 1.0 + clampf(float(modifiers.get("outgoing_factor", 0.0)), -0.5, 0.5)
+	if str(actor.get("v63_blood_mode", "")) == "blood_covenant":
+		expected_factor *= 1.2
+	if not _check(is_equal_approx(float(attack.attack), float(actor.stats.attack) * expected_factor), "passive/innate outgoing modifier was not applied: " + id):
+		return false
+	var defense := V63HumanSkillCombatSystem.effective_defense_stats(actor, actor.stats)
+	var guard_factor := clampf(float(modifiers.get("guard_factor", 1.0)), 0.5, 1.0)
+	var base_reduction := clampf(float(actor.stats.get("damage_reduction", 0.0)), 0.0, 0.95)
+	var expected_reduction := 1.0 - (1.0 - base_reduction) * guard_factor
+	return _check(is_equal_approx(float(defense.damage_reduction), expected_reduction), "passive/innate guard modifier was not applied: " + id)
