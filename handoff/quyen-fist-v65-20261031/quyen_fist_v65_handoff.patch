+func _test_blood_mark_icd() -> bool:
+	var definitions := V63HumanSkillCombatSystem.skill_definitions()
+	var ids := [
+		"tmb.skill.fist.huyet_quyen.active_02.human",
+		"tmb.skill.fist.huyet_quyen.active_03.human",
+		"tmb.skill.fist.huyet_quyen.active_04.human"
+	]
+	var actor := _make_actor(definitions[ids[0]], 400)
+	actor["v63_skill_loadout"] = ids.duplicate()
+	var target := _make_target(400)
+	var battle := _new_battle(actor, target, 400)
+	var caster: Dictionary = battle.actors[str(actor.id)]
+	var enemy: Dictionary = battle.actors[str(target.id)]
+	var first_frenzy_until := -1.0
+	for index in range(ids.size()):
+		if not _check(V63HumanSkillCombatSystem.try_cast(battle, caster, enemy), "Huyet Ma mark cast did not start: " + ids[index]):
+			return false
+		var pending: Dictionary = caster.get("v63_pending_cast", {})
+		battle.now = float(pending.get("ready", battle.now))
+		battle._release_casts()
+		if index == 1:
+			var frenzy = _event_for(battle, "blood_frenzy", ids[index])
+			if not _check(frenzy != null and float(frenzy.get("family_icd", 0.0)) == 35.0, "two unique valid Blood Marks did not trigger the 5s/35s frenzy rule"):
+				return false
+			first_frenzy_until = float(caster.get("v63_blood_frenzy_until", -1.0))
+		if index == 2 and not _check(_event_count(battle, "blood_frenzy") == 1 and is_equal_approx(float(caster.get("v63_blood_frenzy_until", -1.0)), first_frenzy_until), "Blood Frenzy stacked or refreshed inside the family ICD"):
+			return false
+	return _check(enemy.get("v63_blood_marks", {}).size() == 3, "Blood Marks were not retained on their valid target")
+
+func _event_count(battle: MapBattleV2, event_type: String) -> int:
+	var count := 0
+	for event in battle.events:
+		if str(event.get("type", "")) == event_type:
+			count += 1
+	return count
