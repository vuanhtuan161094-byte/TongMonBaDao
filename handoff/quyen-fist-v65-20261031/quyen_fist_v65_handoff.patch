+func _event_for(battle: MapBattleV2, event_type: String, skill_id: String) -> Variant:
+	for index in range(battle.events.size() - 1, -1, -1):
+		var event: Dictionary = battle.events[index]
+		if str(event.get("type", "")) == event_type and str(event.get("skill_id", "")) == skill_id:
+			return event
+	return null
