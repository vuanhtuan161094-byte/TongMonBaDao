+func _snapshot_round_trip(battle: MapBattleV2, source_actor: Dictionary, row: Dictionary, skill_id: String) -> bool:
+	var saved := MapBattleSnapshotV2.save(battle)
+	if not _check(bool(saved.get("ok", false)), "snapshot save failed: " + skill_id):
+		return false
+	var restored := MapBattleSnapshotV2.load(saved)
+	if not _check(bool(restored.get("ok", false)), "snapshot reload failed: " + skill_id + " / " + str(restored)):
+		return false
+	var resumed: MapBattleV2 = restored.get("battle")
+	var actor: Dictionary = resumed.actors.get(str(source_actor.get("id", "")), {})
+	if not actor.is_empty() and str(row.get("branch", "")) == "huyet_quyen" and _generation(row) in ["immortal", "divine"]:
+		return _check(str(actor.get("v63_blood_mode", "")) in ["blood_ma", "blood_life", "blood_covenant"] and float(actor.get("v63_base_max_hp", 0.0)) > 0.0,
+			"snapshot lost lineage survival state: " + skill_id)
+	return _check(not actor.is_empty(), "snapshot lost caster actor: " + skill_id)
