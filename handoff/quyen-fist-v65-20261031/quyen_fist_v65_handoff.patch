+	var miss: Variant = _event_for(battle, "skill_miss", id)
+	return _check(miss != null and str(miss.get("reason", "")) == "target_out_of_range_at_release"
+		and _event_for(battle, "v63_skill_hit", id) == null and is_equal_approx(float(enemy.hp), hp_before),
