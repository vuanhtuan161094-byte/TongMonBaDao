index 78318ad..e1235b1 100644
--- a/godot/src/simulation/combat/v63_immortal_skill_combat_system.gd
+++ b/godot/src/simulation/combat/v63_immortal_skill_combat_system.gd
@@ -163,6 +163,43 @@ static func boss_skill_definitions(boss_id: String) -> Dictionary:
 static func is_immortal_skill(skill_id: String) -> bool:
 	return not skill_definition(skill_id).is_empty()
 
+static func attach_immortal_state(actor: Dictionary, lineage: String) -> void:
+	actor["v63_combat_generation"] = "immortal"
+	if str(actor.get("v63_combat_branch_id", "")) != "huyet_quyen":
+		return
+	var base := float(actor.get("max_hp", 0.0))
+	if base <= 0.0:
+		return
+	actor["v63_base_max_hp"] = base
+	actor["v63_blood_mode"] = "blood_life" if lineage == "b" else "blood_ma"
+	if lineage == "b":
+		return
+	actor["max_hp"] = base * 0.75
+	actor["hp"] = minf(float(actor.get("hp", 0.0)), float(actor.max_hp))
+	actor["stats"] = actor.get("stats", {}).duplicate(true)
+	actor.stats["max_hp"] = float(actor.max_hp)
+
+static func healing_amount(caster: Dictionary, target: Dictionary, amount: float) -> float:
+	if str(target.get("v63_blood_mode", "")) != "blood_ma":
+		return amount
+	var original_max := maxf(1.0, float(target.get("v63_base_max_hp", target.get("max_hp", 1.0))))
+	if str(caster.get("id", "")) == str(target.get("id", "")) or float(target.get("hp", 0.0)) >= 0.40 * original_max:
+		return 0.0
+	return maxf(0.0, amount) * 0.60
+
+static func release_cast(battle: MapBattleV2, cast: Dictionary, caster: Dictionary) -> void:
+	var skill_id := str(cast.get("v63_skill_id", ""))
+	var definition := skill_definition(skill_id)
+	var adjusted := cast.duplicate(true)
+	if not definition.is_empty() and str(definition.get("branch", "")) == "huyet_quyen" and str(definition.get("lineage", "")) == "a":
+		var before := float(caster.get("hp", 0.0))
+		var cost_fraction := 0.12 if str(definition.get("slot", "")) == "ultimate" else 0.10
+		var cost := minf(maxf(0.0, before - 1.0), before * cost_fraction)
+		caster["hp"] = before - cost
+		battle._sync_linked_hp(caster)
+		battle._event("blood_sacrifice", {"caster":str(caster.get("id", "")),"skill_id":skill_id,"generation":"immortal","lineage":"a","hp_before":before,"spent_hp":cost,"hp_after":float(caster.hp),"damage_packet":false})
+	V63HumanSkillCombatSystem.release_cast_base(battle, adjusted, caster)
+
 static func is_immortal_boss(boss_id: String) -> bool:
 	return not boss_definition(boss_id).is_empty()
 
diff --git a/godot/tests/simulation/tmb_quyen_183_combat_handoff_test.gd b/godot/tests/simulation/tmb_quyen_183_combat_handoff_test.gd
new file mode 100644
index 0000000..01a531e
--- /dev/null
+++ b/godot/tests/simulation/tmb_quyen_183_combat_handoff_test.gd
@@ -0,0 +1,452 @@
+extends SceneTree
+
+const BRANCHES := ["ba_quyen", "kim_cang", "huyet_quyen"]
+const GENERATIONS := ["human", "immortal", "divine"]
+const PREVIEW := {"sect_codex":true,"human_skill_combat":true,"divine_skill_combat":true}
+const BASE_HP := 20000.0
+
+func _init() -> void:
+	call_deferred("_run")
+
+func _fail(message: String) -> void:
+	push_error("TMB_QUYEN_183_HANDOFF_FAIL: " + message)
+	quit(1)
+
+func _check(value: bool, message: String) -> bool:
+	if not value:
+		_fail(message)
+		return false
+	return true
+
+func _run() -> void:
+	if V63FeatureGates.is_enabled("human_skill_combat") or V63FeatureGates.is_enabled("divine_skill_combat"):
+		_fail("combat feature gates must remain OFF by default")
+		return
+	if not V63FeatureGates.is_enabled("human_skill_combat", PREVIEW) or not V63FeatureGates.is_enabled("divine_skill_combat", PREVIEW):
+		_fail("preview gates must enable Human and Divine combat fixtures")
+		return
+	var records := _quyen_records()
+	if not _check(records.size() == 183, "catalogue filter must cover exactly 183 fist records; got " + str(records.size())):
+		return
+	var counts := {"human":0,"immortal":0,"divine":0}
+	for row in records:
+		counts[_generation(row)] += 1
+	if not _check(counts == {"human":35,"immortal":68,"divine":80}, "generation coverage changed: " + str(counts)):
+		return
+	for index in range(records.size()):
+		if not _test_record(records[index], index):
+			return
+	if not _test_blood_contract():
+		return
+	if not _test_multi_kim_cang_huyet_team():
+		return
+	if not _test_blood_mark_icd():
+		return
+	if not _test_range_revalidation():
+		return
+	print("TMB_QUYEN_183_HANDOFF_PASS: 183 records dispatched by slot/effect; cast/release/hit receipts, Combat V2 guard/HP, lineage state and snapshot round-trip exercised")
+	quit(0)
+
+func _quyen_records() -> Array:
+	var result: Array = []
+	for raw in V63HumanSkillCombatSystem.skill_definitions().values():
+		if not (raw is Dictionary) or str(raw.get("school", "")) != "fist":
+			continue
+		var slot := str(raw.get("slot", ""))
+		if BRANCHES.has(str(raw.get("branch", ""))) or slot in ["basic", "mobility"]:
+			result.append(raw.duplicate(true))
+	result.sort_custom(func(a: Dictionary, b: Dictionary) -> bool: return str(a.get("id", "")) < str(b.get("id", "")))
+	return result
+
+func _generation(row: Dictionary) -> String:
+	return str(row.get("generation", row.get("tier", "human")))
+
+func _test_record(row: Dictionary, index: int) -> bool:
+	var actor := _make_actor(row, index)
+	var target := _make_target(index)
+	var slot := str(row.get("slot", ""))
+	var skill_id := str(row.get("id", ""))
+	var generation := _generation(row)
+	if slot in ["passive", "innate"]:
+		if not _test_modifiers(row, actor):
+			return false
+		var passive_battle := _new_battle(actor, target, index)
+		return _snapshot_round_trip(passive_battle, actor, row, skill_id)
+	elif slot == "mobility":
+		var distance := minf(float(row.get("range", 0.0)) - 0.1, 2.5)
+		if distance <= float(actor.get("basic_range", 1.5)) + 0.2:
+			return _check(false, "fist mobility range cannot close a short gap: " + skill_id)
+		target["position"] = actor["position"] + Vector2(distance, 0.0)
+		var mobility_battle := _new_battle(actor, target, index)
+		var live_actor: Dictionary = mobility_battle.actors[str(actor.id)]
+		var live_target: Dictionary = mobility_battle.actors[str(target.id)]
+		if generation == "divine" and not _check(int(live_actor.get("v63_divine_stage", 0)) == 2, "MapBattle setup dropped the attached Divine stage: " + skill_id):
+			return false
+		var before: Vector2 = live_actor.position
+		if not _check(V63HumanSkillCombatSystem.try_cast(mobility_battle, live_actor, live_target), "mobility did not trigger: " + skill_id):
+			return false
+		if not _check((live_actor.position as Vector2).distance_to(before) > 0.1 and _event_for(mobility_battle, "v63_mobility", skill_id) != null, "mobility did not move or record its hit: " + skill_id):
+			return false
+		return _snapshot_round_trip(mobility_battle, actor, row, skill_id)
+	elif slot == "basic":
+		var basic_battle := _new_battle(actor, target, index)
