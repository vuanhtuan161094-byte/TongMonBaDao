+func _combat_hit_for(battle: MapBattleV2, attacker_id: String) -> Variant:
+	for event in battle.events:
+		if str(event.get("type", "")) == "hit" and str(event.get("kind", "")) == "v63_skill" and str(event.get("attacker", "")) == attacker_id and str(event.get("target", "")) == "fist_target_300":
+			return event
+	return null
