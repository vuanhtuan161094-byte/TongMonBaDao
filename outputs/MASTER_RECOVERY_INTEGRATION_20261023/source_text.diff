--- /dev/null
+++ b/godot/src/presentation/p3/combat_v4_sprite_atlas.gd
@@ -0,0 +1,90 @@
+class_name CombatV4SpriteAtlas
+extends RefCounted
+
+# View-only reader for selected, owner-provided Source VL sheets.
+# Metadata is copied from the exact sprites.json source rects/anchor/dirs; no grid guessing.
+const INDEX_PATH := "res://assets/combat_v4/source_vl/atlas_manifest.json"
+const ATLAS_ROOT := "res://assets/combat_v4/source_vl/"
+const DEFAULT_FPS := 12.0
+var sheets: Dictionary = {}
+var texture_cache: Dictionary = {}
+
+func _init() -> void:
+    if not FileAccess.file_exists(INDEX_PATH):
+        return
+    var parsed = JSON.parse_string(FileAccess.get_file_as_string(INDEX_PATH))
+    if parsed is Dictionary:
+        sheets = parsed.get("atlases", {})
+
+func has_actor(actor_key: String) -> bool:
+    return sheets.has(actor_key)
+
+func frame_region(actor_key: String, action: String, facing: Vector2, elapsed: float) -> Dictionary:
+    var source: Dictionary = sheets.get(actor_key, {})
+    if source.is_empty():
+        return {}
+    var actions: Dictionary = source.get("actions", {})
+    var clip: Dictionary = actions.get(action, actions.get("idle", {}))
+    if clip.is_empty():
+        return {}
+    var file_name := str(clip.get("image", ""))
+    if file_name.is_empty() or file_name.contains("/") or file_name.contains("\\"):
+        return {}
+    var texture := _texture(file_name)
+    if texture == null:
+        return {}
+    var frames := int(clip.get("frames", 0))
+    var dirs := int(source.get("directions", 0))
+    var rects: Array = clip.get("rects", [])
+    if frames < 1 or dirs < 1 or rects.size() != frames * dirs * 6:
+        return {}
+    var fps := DEFAULT_FPS
+    # Honor authentic idle cycle durations where exported by Source VL.
+    # Other actions have no documented duration in the selected source manifest.
+    var cycle_value = clip.get("duration", null)
+    if cycle_value is float or cycle_value is int:
+        if float(cycle_value) > 0.0:
+            fps = float(frames) / float(cycle_value)
+    var frame_index := int(floor(maxf(elapsed, 0.0) * fps))
+    if action in ["attack", "hit", "die"]:
+        frame_index = mini(frame_index, frames - 1)
+    else:
+        frame_index = posmod(frame_index, frames)
+    var direction := facing.normalized() if facing.length_squared() > 0.0001 else Vector2.RIGHT
+    var dir_index := posmod(int(round(direction.angle() * float(dirs) / TAU)) + int(source.get("dir_offset", 0)), dirs)
+    var offset := (dir_index * frames + frame_index) * 6
+    var x := int(rects[offset])
+    var y := int(rects[offset + 1])
+    var width := int(rects[offset + 2])
+    var height := int(rects[offset + 3])
+    if x < 0 or y < 0 or width <= 0 or height <= 0:
+        return {}
+    if x + width > texture.get_width() or y + height > texture.get_height():
+        return {}
+    return {
+        "texture": texture,
+        "source": Rect2(float(x), float(y), float(width), float(height)),
+        "anchor": Vector2(float(rects[offset + 4]), float(rects[offset + 5])),
+        "frame": frame_index, "direction": dir_index,
+        "scale": float(source.get("scale", 1.0))
+    }
+
+func draw_actor(canvas: CanvasItem, actor_key: String, action: String, foot: Vector2,
+        facing: Vector2, elapsed: float, art_scale: float = 1.0) -> bool:
+    var info := frame_region(actor_key, action, facing, elapsed)
+    if info.is_empty():
+        return false
+    var source: Rect2 = info["source"]
+    var ratio: float = art_scale * float(info["scale"])
+    var anchor: Vector2 = info["anchor"]
+    var dest := Rect2(foot - anchor * ratio, source.size * ratio)
+    canvas.draw_texture_rect_region(info["texture"], dest, source)
+    return true
+
+func _texture(file_name: String) -> Texture2D:
+    if texture_cache.has(file_name):
+        return texture_cache[file_name]
+    var resource = load(ATLAS_ROOT + file_name)
+    var texture := resource as Texture2D
+    texture_cache[file_name] = texture
+    return texture
diff --git a/godot/src/presentation/p3/combat_v5_source_a_atlas.gd b/godot/src/presentation/p3/combat_v5_source_a_atlas.gd
new file mode 100644
index 0000000..1b5cb2e
--- /dev/null
+++ b/godot/src/presentation/p3/combat_v5_source_a_atlas.gd
@@ -0,0 +1,169 @@
+class_name CombatV5SourceAAtlas
+extends CombatV4SpriteAtlas
+
+## View-only adapter for native Spine 3.8 clips baked by the existing
+## SpineToGodot472 pipeline. No gameplay state is read or changed here.
+const MANIFEST_PATH := "res://assets/combat_v5_source_a/visual_manifest.json"
+const ACTORS_ROOT := "res://assets/actors/"
+
+var _actors: Dictionary = {}
+var _packs: Dictionary = {}
+
+func _init() -> void:
+	super()
+	if not FileAccess.file_exists(MANIFEST_PATH):
+		return
+	var parsed = JSON.parse_string(FileAccess.get_file_as_string(MANIFEST_PATH))
+	if not (parsed is Dictionary):
+		return
+	var rows: Dictionary = parsed.get("actors", {})
+	for actor_key in rows:
+		if not (rows[actor_key] is Dictionary):
+			continue
+		var row: Dictionary = rows[actor_key]
+		var base_id := str(row.get("base_asset", ""))
+		var combat_id := str(row.get("combat_asset", ""))
+		var base_pack := _load_pack(base_id)
+		var combat_pack := _load_pack(combat_id)
+		if base_pack.is_empty() and combat_pack.is_empty():
+			continue
+		_actors[str(actor_key)] = {
+			"base": base_pack,
+			"combat": combat_pack,
+			"base_scale": float(row.get("base_scale", 0.5)),
+			"combat_scale": float(row.get("combat_scale", 0.5)),
+			"source_face_x": -1 if int(row.get("source_face_x", -1)) < 0 else 1
+		}
+
+func has_actor(actor_key: String) -> bool:
+	return _actors.has(actor_key)
+
+func frame_region(actor_key: String, action: String, facing: Vector2, elapsed: float) -> Dictionary:
+	var resolved := _resolve(actor_key, action)
+	if resolved.is_empty():
+		return {}
+	var pack: Dictionary = resolved["pack"]
+	var frames: SpriteFrames = pack["frames"]
+	var clip_name := str(resolved["clip"])
+	var count := frames.get_frame_count(clip_name)
+	if count < 1:
+		return {}
+	var speed := maxf(0.001, frames.get_animation_speed(clip_name))
+	var durations: Array[float] = []
+	var duration_total := 0.0
+	for index in range(count):
+		var value := maxf(0.001, frames.get_frame_duration(clip_name, index) / speed)
+		durations.append(value)
+		duration_total += value
+	if duration_total <= 0.0:
+		return {}
+	var sample_time := maxf(0.0, elapsed)
+	if frames.get_animation_loop(clip_name):
+		sample_time = fposmod(sample_time, duration_total)
+	else:
+		sample_time = minf(sample_time, maxf(0.0, duration_total - 0.0001))
+	var frame_index := count - 1
+	for index in range(count):
+		if sample_time < durations[index] or index == count - 1:
+			frame_index = index
+			break
+		sample_time -= durations[index]
+	var texture := frames.get_frame_texture(clip_name, frame_index)
+	if texture == null:
+		return {}
+	return {
+		"texture": texture,
+		"source": Rect2(Vector2.ZERO, texture.get_size()),
+		"anchor": pack["anchor"],
+		"frame": frame_index,
+		"direction": 0,
+		"scale": float(resolved["scale"]),
+		"source_face_x": int(_actors[actor_key]["source_face_x"])
+	}
+
+func action_duration(actor_key: String, action: String) -> float:
+	var resolved := _resolve(actor_key, action)
+	if resolved.is_empty():
+		return 0.0
+	var frames: SpriteFrames = resolved["pack"]["frames"]
+	var clip_name := str(resolved["clip"])
+	var speed := maxf(0.001, frames.get_animation_speed(clip_name))
+	var total := 0.0
+	for index in range(frames.get_frame_count(clip_name)):
+		total += maxf(0.001, frames.get_frame_duration(clip_name, index) / speed)
+	return total
+
+func draw_actor(canvas: CanvasItem, actor_key: String, action: String, foot: Vector2,
+		facing: Vector2, elapsed: float, art_scale: float = 1.0) -> bool:
+	var info := frame_region(actor_key, action, facing, elapsed)
+	if info.is_empty():
+		return false
+	var texture: Texture2D = info["texture"]
+	var source: Rect2 = info["source"]
+	var anchor: Vector2 = info["anchor"]
+	var ratio := art_scale * float(info["scale"])
+	var face_left := facing.x < -0.001
+	var native_left := int(info["source_face_x"]) < 0
+	if face_left == native_left:
+		canvas.draw_texture_rect_region(texture,
+			Rect2(foot - anchor * ratio, source.size * ratio), source)
+	else:
+		canvas.draw_set_transform(foot, 0.0, Vector2(-ratio, ratio))
+		canvas.draw_texture_rect_region(texture,
+			Rect2(Vector2(-anchor.x, -anchor.y), source.size), source)
+		canvas.draw_set_transform(Vector2.ZERO, 0.0, Vector2.ONE)
+	return true
+
+func _resolve(actor_key: String, action: String) -> Dictionary:
+	if not _actors.has(actor_key):
+		return {}
+	var row: Dictionary = _actors[actor_key]
+	var candidates: Array[String] = []
+	match action:
+		"attack", "cast": candidates = ["attack1", "attack"]
+		"hit": candidates = ["hit"]
+		"die", "dead": candidates = ["dead", "die"]
+		"run", "walk": candidates = ["walk", "run"]
+		_: candidates = ["stand", "idle1", "idle", "idle2"]
+	var order := ["combat", "base"] if action in ["attack", "cast", "hit", "die", "dead"] else ["base", "combat"]
+	for pack_key in order:
+		var pack: Dictionary = row.get(pack_key, {})
+		if pack.is_empty():
+			continue
+		var frames: SpriteFrames = pack["frames"]
+		for clip_name in candidates:
+			if frames.has_animation(clip_name) and frames.get_frame_count(clip_name) > 0:
+				return {
+					"pack": pack,
+					"clip": clip_name,
+					"scale": float(row["combat_scale"] if pack_key == "combat" else row["base_scale"])
+				}
+	return {}
+
+func _load_pack(asset_id: String) -> Dictionary:
+	if asset_id.is_empty() or asset_id.contains("/") or asset_id.contains("\\") or asset_id.contains(".."):
+		return {}
+	if _packs.has(asset_id):
+		return _packs[asset_id]
+	var root := ACTORS_ROOT + asset_id + "/"
+	var manifest_path := root + "asset.json"
+	var animation_path := root + "animations.tres"
+	if not FileAccess.file_exists(manifest_path) or not FileAccess.file_exists(animation_path):
+		_packs[asset_id] = {}
+		return {}
+	var metadata = JSON.parse_string(FileAccess.get_file_as_string(manifest_path))
+	var frames := load(animation_path) as SpriteFrames
+	if not (metadata is Dictionary) or frames == null:
+		_packs[asset_id] = {}
+		return {}
+	var offset: Array = metadata.get("offset", [])
+	if offset.size() != 2:
+		_packs[asset_id] = {}
+		return {}
+	var pack := {
+		"frames": frames,
+		"anchor": Vector2(-float(offset[0]), -float(offset[1])),
+		"metadata": metadata
+	}
+	_packs[asset_id] = pack
+	return pack
diff --git a/godot/src/presentation/p3/disciple_six_dimension_radar.gd b/godot/src/presentation/p3/disciple_six_dimension_radar.gd
