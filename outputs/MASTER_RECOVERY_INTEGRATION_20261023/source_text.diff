+
+var camera: Camera2D
+var surface: Node2D
+var display_instances: Array[Dictionary] = []
+var tiles: Dictionary = {}
+var active_chunks: Array[Vector2i] = []
+# Chunk-local immutable ArrayMesh, cached in memory; purely visual, no save data.
+var ground_chunk_meshes: Dictionary = {}
+var draw_revision := 0
