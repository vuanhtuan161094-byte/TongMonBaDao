+        return float(a["y"]) < float(b["y"])
+    )
+    for entry in queue:
+        var item: Dictionary = entry["data"]
+        var place: Vector2 = item["world"]
+        if str(entry["kind"]) == "vegetation":
+            var tex: Texture2D = item["texture"]
+            var scaled := tex.get_size()*float(item["scale"])
