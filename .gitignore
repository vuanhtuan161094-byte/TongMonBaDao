# Local verification/diagnostic output must not block Sync-P2-6.cmd.
/VERIFY_*.txt
/VERIFY*.txt
/*_DIAGNOSTIC.txt
/*DIAGNOSTIC*.txt

# P3.2 female_normal_v1 Stage A runtime PNGs are reconstructed locally from
# the validated diagnostic ZIP. Keep only these exact generated proof files
# out of git status without hiding unrelated/future character art.
/godot/assets/p3/character_creator/parts/female_normal_v1/body/body_01/body_01_down_*.png
/godot/assets/p3/character_creator/parts/female_normal_v1/body/body_01/body_01_right_*.png
