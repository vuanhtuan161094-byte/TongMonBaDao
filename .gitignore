# Optional local copy of the validated diagnostic ZIP. The installer also finds
# it automatically in Downloads/Desktop and checks SHA-256 before extraction.
/female_normal_v1_stageA_runtime_pack_v2_quant*.zip

# Godot writes a .png.import sidecar beside each locally reconstructed Stage A
# texture. These are generated import metadata for the same proof assets, not
# source art. Ignore only the exact Stage A sidecar patterns as well.
/godot/assets/p3/character_creator/parts/female_normal_v1/body/body_01/body_01_down_*.png.import
