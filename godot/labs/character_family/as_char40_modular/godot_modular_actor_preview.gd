extends Node2D
## AS-CHAR-40 modular presentation-only LAB. NO rig, NO gameplay authority.
## A source pack must first be generated by tools/build_modular.py.
## The lab refuses to present missing assets as authored animation.
@export_dir var generated_pack_dir: String = "res://labs/character_family/as_char40_modular/out"
@export var actor_id: String = "male_base_v1"
@export var initial_weapon_item: String = "jian_blue"

const STATES := ["idle", "walk", "attack", "cast", "hit", "death"]
const DIRECTIONS := ["front", "right", "back", "left"]
var _body: AnimatedSprite2D
var _weapon_behind: AnimatedSprite2D
var _weapon_front: AnimatedSprite2D
var _weapon_items: Array[String] = []
var _active_weapon: String = ""
var _state: String = "idle"
var _direction: String = "front"
var _hud: Label
var _status: String = "ART_PENDING"

func _ready() -> void:
    position = get_viewport_rect().size * 0.5 + Vector2(0, 40)
    _weapon_behind = _make_sprite(-1)
    _body = _make_sprite(0)
    _weapon_front = _make_sprite(1)
    _body.frame_changed.connect(_sync_weapon_frames)
    var canvas := CanvasLayer.new()
    add_child(canvas)
    _hud = Label.new()
    _hud.position = Vector2(16, 16)
    canvas.add_child(_hud)
    _load_pack()

func _make_sprite(z: int) -> AnimatedSprite2D:
    var sprite := AnimatedSprite2D.new()
    sprite.z_index = z
    sprite.centered = true
    sprite.position = Vector2(0, -40) # logical foot (64,104) on a 128x128 atlas
    sprite.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
    add_child(sprite)
    return sprite

func _load_pack() -> void:
    var file_path := generated_pack_dir + "/export_manifest.json"
    if not FileAccess.file_exists(file_path):
        _status = "NO AUTHORED SOURCE — no preview"
        _refresh_hud()
        return
    var manifest := JSON.parse_string(FileAccess.get_file_as_string(file_path))
    if not manifest is Dictionary or str(manifest.get("actor_id", "")) != actor_id:
        _status = "REJECTED: source pack/identity mismatch"
        _refresh_hud()
        return
    _status = str(manifest.get("source_status", "ART_PENDING"))
    _weapon_items.clear()
    for item in manifest.get("weapon_items", []):
        _weapon_items.append(str(item))
    var body_resource := load(generated_pack_dir + "/" + actor_id + "__body.tres")
    if not body_resource is SpriteFrames:
        _status = "INVALID: missing body SpriteFrames"
        _refresh_hud()
        return
    _body.sprite_frames = body_resource
    if _weapon_items.is_empty():
        _active_weapon = "unarmed"
    else:
        _active_weapon = initial_weapon_item if initial_weapon_item in _weapon_items else _weapon_items[0]
        _change_weapon(_active_weapon)
    _change_clip("walk", "front")

func _change_weapon(item: String) -> void:
    if not item in _weapon_items:
        return
    var back_res := load(generated_pack_dir + "/" + actor_id + "__" + item + "_back.tres")
    var front_res := load(generated_pack_dir + "/" + actor_id + "__" + item + "_front.tres")
    if not back_res is SpriteFrames or not front_res is SpriteFrames:
        _status = "INVALID: incomplete authored weapon layers"
        _refresh_hud()
        return
    _weapon_behind.sprite_frames = back_res
    _weapon_front.sprite_frames = front_res
    _active_weapon = item
    _sync_weapon_frames()
    _refresh_hud()

func _change_clip(state: String, direction: String) -> void:
    if _body.sprite_frames == null:
        return
    var clip := state + "_" + direction
    if not _body.sprite_frames.has_animation(clip):
        _status = "MISSING REAL CLIP: " + clip
        _refresh_hud()
        return
    _state = state
    _direction = direction
    _body.play(clip)
    _sync_weapon_frames()
    _refresh_hud()

func _sync_weapon_frames() -> void:
    # Only the authored body timeline advances. Both real weapon textures
    # snap to the same frame, without Skeleton2D/Bone2D/rotating body sprites.
    if _body == null or _body.sprite_frames == null:
        return
    for weapon in [_weapon_behind, _weapon_front]:
        if weapon == null or weapon.sprite_frames == null:
            continue
        if weapon.sprite_frames.has_animation(_body.animation):
            weapon.animation = _body.animation
            weapon.set_frame_and_progress(_body.frame, 0.0)

func _unhandled_key_input(event: InputEvent) -> void:
    if not event is InputEventKey or not event.pressed or event.echo:
        return
    match event.keycode:
        KEY_1: _change_clip(STATES[0], _direction)
        KEY_2: _change_clip(STATES[1], _direction)
        KEY_3: _change_clip(STATES[2], _direction)
        KEY_4: _change_clip(STATES[3], _direction)
        KEY_5: _change_clip(STATES[4], _direction)
        KEY_6: _change_clip(STATES[5], _direction)
        KEY_D: _change_clip(_state, DIRECTIONS[(DIRECTIONS.find(_direction) + 1) % DIRECTIONS.size()])
        KEY_E:
            if not _weapon_items.is_empty():
                _change_weapon(_weapon_items[(_weapon_items.find(_active_weapon) + 1) % _weapon_items.size()])

func _refresh_hud() -> void:
    if _hud != null:
        _hud.text = "AS-CHAR modular LAB | " + _status + "\n" + actor_id + " / " + _state + "_" + _direction + " / " + _active_weapon + "\n1–6 states | D direction | E weapon\nNO RIG — NO PROD ART APPROVAL"
