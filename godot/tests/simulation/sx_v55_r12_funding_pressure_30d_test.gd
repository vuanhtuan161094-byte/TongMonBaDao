extends SceneTree

# Read-only feasibility model for *earned* R1/R2 work gross, suggested
# T2 BASE site taxes, and W2 minimum. Not a real 30-day playthrough, income
# event, or permission to enable the QA-locked policy for the player.
const MINUTES_PER_WORKER_DAY := 360
const WORKERS_PER_SITE := 2

func _init() -> void:
    call_deferred("_run")

func _check(value: bool, reason: String) -> bool:
    if not value:
        push_error("SX V55 R12 FUNDING PRESSURE FAIL: "+reason)
        quit(1)
        return false
    return true

# Two independent 6/30-person cash-pressure cases. The 30-roster is
# generated by the actual recruitment API with a QA-only capacity override;
# it does NOT prove that players can acquire 30 paid beds or worksite slots.
# No new material or Spirit Stone is granted.
func _audit_6_30_rosters_no_npc() -> bool:
    var study := P37Factory.create_state(550330)
    var economy := EconomySystem.new()
    if not _check(bool(economy.enable_v1(study).get("ok",false))
        and study.disciples.size() == 6
        and study.sect.spirit_stones == 500
        and not economy.sx_v55_r12_enabled(study),
        "study must begin from real six-disciple 500 LT NewGame"):
        return false
    var quota_6 := economy.effective_market_daily_units(study)
    if not _check(quota_6 == 20, "real 6-person market ceiling changed"):
        return false

    # QA scenario only: check market scaling with 30 genuine accepted actors.
    # A real owner must construct and pay for housing; this test skips that
    # economic gate solely to isolate the market/roster branch.
    study.sect.disciple_capacity = 30
    var recruiter := RecruitmentSystem.new()
    while study.disciples.size() < 30:
        var candidate := recruiter.generate_candidate(study)
        if not _check(candidate != null,"QA scenario candidate generation failed"):
            return false
        var recruited := recruiter.accept_candidate(study,candidate.id)
        if not _check(bool(recruited.get("ok",false)),
            "QA scenario ordinary candidate acceptance failed: "+str(recruited)):
            return false
    var quota_30 := economy.effective_market_daily_units(study)
    if not _check(quota_30 == 240 and quota_30 > quota_6,
        "canonical 30-person daily market volume changed"):
        return false

    var crop := SpiritCropRegistry.new()
    var bulk_plan := BuildingSystem.SX_V55_BULK_PLANS
    var jobs_6 := 2*int(360/int(bulk_plan["thanh_thiet"]["cycle_ticks"])) \
        +2*int(360/int(bulk_plan["linh_moc"]["cycle_ticks"])) \
        +int(360/int(bulk_plan["linh_coc"]["cycle_ticks"])) \
        +int(360/int(bulk_plan["thanh_linh_thao"]["cycle_ticks"]))
    var seed_6 := int(360/int(bulk_plan["linh_coc"]["cycle_ticks"]))*crop.cost(&"linh_coc") \
        +int(360/int(bulk_plan["thanh_linh_thao"]["cycle_ticks"]))*crop.cost(&"thanh_linh_thao")
    var wage_each := int(study.sect.economy_a_policy.get("wage_per_batch",-1))
    var first_stones := study.sect.spirit_stones
    var sale_price := economy.market_sell_price(&"thanh_thiet")
    if not _check(jobs_6 == 34 and seed_6 == 34 and wage_each == 2
        and sale_price == 8 and first_stones == 500,
        "genuine Mine/Forest/Field producer rates or NPC ore price drifted"):
        return false

    # 30 owned with the *same six staffed producer slots* has the SAME cash
    # need. The 30-active scenario is an upper-bound planning allocation:
    # 10 miners, 10 foresters, 5 grain and 5 herb planters. Additional paid
    # worksite capacity is NOT tested or implicitly created here.
    for worker_count in [6,30]:
        var multiplier := int(worker_count/6)
        var jobs_per_day := jobs_6*multiplier
        var seeds_per_day := seed_6*multiplier
        var wages_per_day := jobs_per_day*wage_each
        var no_npc_day_need := seeds_per_day+wages_per_day
        var roster_quota := quota_6 if worker_count == 6 else quota_30
        var npc_ore_ceiling := roster_quota*sale_price
        if not _check((worker_count != 6 or (jobs_per_day == 34
            and no_npc_day_need == 102 and npc_ore_ceiling == 160))
            and (worker_count != 30 or (jobs_per_day == 170
            and no_npc_day_need == 510 and npc_ore_ceiling == 1920)),
            "30-worker conditional scenario or 6/30 market cap changed"):
            return false
        for days in [1,7,30]:
            var legacy_gap := maxi(0,no_npc_day_need*days-first_stones)
            var hypothetical_r12_gap := maxi(0,seeds_per_day*days-first_stones)
            var no_sale_treasury_delta: int = -no_npc_day_need*int(days)
            var target_legacy := legacy_gap
            var target_r12 := hypothetical_r12_gap
            # Mathematical source conservation: all inflows excluded; T2
            # transfers ZERO and genuine r1/r2 long-batch W2 topup ZERO.
            if not _check(target_legacy == maxi(0,-no_sale_treasury_delta-first_stones)
                and target_r12 == maxi(0,seeds_per_day*days-first_stones)
                and not economy.sx_v55_r12_enabled(study),
                "zero-income cash gap or disabled income pilot drifted"):
                return false
            print("GP2C_ROSTER_ZERO_TAX_NO_NPC_HOLD roster=",worker_count,
                " active_qa_workers=",worker_count,
                " days=",days,
                " paid_capacity_proven=false",
                " consumer_cadence_scenario_only=true",
                " market_units_if_NPC=",roster_quota,
                " NPC_sale_LT=0",
                " hypothetical_NPC_ceiling_LT_per_day=",npc_ore_ceiling,
                " daily_seed_LT=",seeds_per_day,
                " daily_EconomyA_wage_LT=",wages_per_day,
                " legacy_unfunded_LT=",legacy_gap,
                " hypothetical_r12_unfunded_LT=",hypothetical_r12_gap,
                " T2_tax_at_zero_LT=0",
                " W2_long_batch_topup_LT=0")
    if not _check(study.sect.spirit_stones == first_stones
        and study.sect.economy_a_receipts.is_empty()
        and study.sect.economy_a_market_units_sold == 0
        and study.sect.economy_a_market_units_bought == 0,
        "scenario illegally credited player funds or genuine market orders"):
        return false
    return true

func _run() -> void:
    if not _audit_6_30_rosters_no_npc():
        return
    var economy := EconomySystem.new()
    var state := P37Factory.create_state(550321)
    if not _check(bool(economy.enable_v1(state).get("ok",false))
        and not economy.sx_v55_r12_enabled(state),
        "simulated design must not activate player income"):
        return
    var plan := BuildingSystem.SX_V55_BULK_PLANS
    var site_min := WORKERS_PER_SITE*MINUTES_PER_WORKER_DAY
    var mine_jobs := WORKERS_PER_SITE*int(floor(float(MINUTES_PER_WORKER_DAY) / float(plan["thanh_thiet"]["cycle_ticks"])))
    var forest_jobs := WORKERS_PER_SITE*int(floor(float(MINUTES_PER_WORKER_DAY) / float(plan["linh_moc"]["cycle_ticks"])))
    var grain_jobs := int(floor(float(MINUTES_PER_WORKER_DAY)/float(plan["linh_coc"]["cycle_ticks"])))
    var herb_jobs := int(floor(float(MINUTES_PER_WORKER_DAY)/float(plan["thanh_linh_thao"]["cycle_ticks"])))
    var jobs := mine_jobs+forest_jobs+grain_jobs+herb_jobs
    if not _check(mine_jobs == 12 and forest_jobs == 12 and grain_jobs == 6
        and herb_jobs == 4 and jobs == 34,"real producer schedule changed"):
        return
    var seed_cost := grain_jobs*SpiritCropRegistry.new().cost(&"linh_coc") \
        +herb_jobs*SpiritCropRegistry.new().cost(&"thanh_linh_thao")
    var npc_max := economy.effective_market_daily_units(state)*economy.market_sell_price(&"thanh_thiet")
    if not _check(seed_cost == 34 and npc_max == 160,"real pilot sink or sale ceiling changed"):
        return
    var reference = JSON.parse_string(FileAccess.get_file_as_string(
        "res://data/economy/v55d_30_realm_reference.json"))
    if not _check(reference is Dictionary and reference.get("runtime_activation",true) == false,
        "approved V5.5-D 30-stage sheet not reference-only"):
        return
    var all_rows: Array = reference.get("realms",[])
    if not _check(all_rows.size() == 30,"original 30-stage workbook incomplete"):
        return
    # The original V5.5-D tab 04_NangCap342 authorizes ×1000 on
    # Spirit Stone NEW upgrade prices. Legacy gameplay stays unchanged.
    var buildings := BuildingSystem.new()
    if not _check(bool(buildings.sx_v55_enable_bulk(state).get("ok",false))
        and not economy.sx_v55_r12_enabled(state),
        "new bulk production must NOT also activate QA economy"):
        return
    # GP2-C HOLD: a no-NPC, zero-T2 scenario is an adverse finance
    # sensitivity, NOT a live 0%-tax option. Confirm the actual player API
    # still rejects the r1/r2 income pilot before modelling it.
    var starter_stones := state.sect.spirit_stones
    var existing_wage_per_batch := int(state.sect.economy_a_policy.get("wage_per_batch",-1))
    var refused_activation := economy.configure_v1(state,EconomySystem.SX_V55_R12_POLICY,true)
    if not _check(starter_stones == 500 and existing_wage_per_batch == 2
        and not bool(refused_activation.get("ok",false))
        and str(refused_activation.get("reason","")) == "design_hold_r12_no_player_activation"
        and not economy.sx_v55_r12_enabled(state)
        and int(EconomySystem.SX_V55_R12_TAX["mine"]) == 70
        and int(EconomySystem.SX_V55_R12_TAX["linh_forest"]) == 30
        and int(EconomySystem.SX_V55_R12_TAX["spirit_field"]) == 40,
        "starter cash, live tax policy, or pilot user-activation HOLD changed"):
        return
    var legacy_daily_need := seed_cost+jobs*existing_wage_per_batch
    # A hypothetical T2=0 cannot transfer earned worker gross to the Sect.
    # V5.5-D W2 is a minimum: the authentic long batches have zero topup.
    var short_batch_topup := 0
    for realm_id in [1,2]:
        var realm_rate: Dictionary = EconomySystem.SX_V55_R12_RATES[realm_id]
        for source_id in ["thanh_thiet","linh_moc","linh_coc","thanh_linh_thao"]:
            var duration := int(plan[source_id]["cycle_ticks"])
            short_batch_topup += maxi(int(realm_rate["wage_per_job"])
                -int(realm_rate["gross_per_minute"])*duration,0)
    if not _check(short_batch_topup == 0 and legacy_daily_need == 102
        and (starter_stones / legacy_daily_need) == 4
        and (starter_stones / seed_cost) == 14,
        "no-NPC starter-seed or genuine W2-floor funding boundary changed"):
        return
    var receipts_before := state.sect.economy_a_receipts.duplicate(true)
    var first_legacy_unfunded_day := int(floor(float(starter_stones)/float(legacy_daily_need)))+1
    var first_r12_unfunded_day := int(floor(float(starter_stones)/float(seed_cost)))+1
    if not _check(first_legacy_unfunded_day == 5 and first_r12_unfunded_day == 15,
        "zero-income days-to-unfunded-seeds/wages must use real starter funds"):
        return
    for days in [1,7,30]:
        # These are unfunded requested expenditures, never negative game
        # balances or a claim that 30d of jobs actually completed.
        var legacy_funding_gap := maxi(0,days*legacy_daily_need-starter_stones)
        var r12_funding_gap := maxi(0,days*seed_cost-starter_stones)
        if not _check((days != 1 or (legacy_funding_gap == 0 and r12_funding_gap == 0))
            and (days != 7 or (legacy_funding_gap == 214 and r12_funding_gap == 0))
            and (days != 30 or (legacy_funding_gap == 2560 and r12_funding_gap == 520)),
            "zero-tax/no-NPC funded-balance sensitivity drifted"):
            return
        print("GP2C_ZERO_TAX_NO_NPC_HOLD days=",days,
            " starter_LT=",starter_stones,
            " real_seed_LT_per_day=",seed_cost,
            " economy_A_wage_LT_per_day=",jobs*existing_wage_per_batch,
            " legacy_unfunded_LT=",legacy_funding_gap,
            " r12_hypothetical_unfunded_LT=",r12_funding_gap,
            " no_NPC_sale_LT=0 no_T2_transfer_LT=0",
            " LT2_W2_T2_public_activation=HOLD")
    if not _check(state.sect.spirit_stones == starter_stones
        and state.sect.economy_a_receipts == receipts_before
        and state.sect.economy_a_market_units_sold == 0,
        "the read-only no-NPC finance audit minted money or Warehouse sales"):
        return
    state.sect.economy_a_policy[EconomySystem.SX_V55_R12_POLICY] = true
    # P37Factory has no Hall; production LiveGameRuntimeV2 creates it
    # through this existing canonical function. No free materials or money.
    if not _check(buildings.ensure_main_hall(state) != null,
        "actual live-runtime Main Hall authority not constructible"):
        return
    var upgrades := [
        {"kind":BuildingSystem.TYPE_MAIN_HALL,"stone":580000},
        {"kind":BuildingSystem.TYPE_SPIRIT_FIELD,"stone":21000},
        {"kind":BuildingSystem.TYPE_MINE,"stone":24000},
        {"kind":BuildingSystem.TYPE_LINH_FOREST,"stone":24000}
    ]
    var first_wave_stone := 0
    var first_wave_wood := 0
    var first_wave_ore := 0
    for entry in upgrades:
        var building := buildings.primary_building(state,entry["kind"])
        if not _check(building != null and building.level == 1,
            "source-backed four founding facilities missing or not Lv1"):
            return
        var original := buildings.upgrade_cost(building)
        var quoted := buildings.sx_v55_upgrade_cost(state,building)
        if not _check(int(quoted.get("spirit_stones",-1)) == int(entry["stone"])
            and int(quoted.get("spirit_stones",-1)) == int(original.get("spirit_stones",0))*1000
            and int(quoted.get("linh_moc",-1)) == int(original.get("linh_moc",0))*1000
            and int(quoted.get("thanh_thiet",-1)) == int(original.get("thanh_thiet",0))*1000,
            "original 04_NangCap342 money scale / already-live bulk material scale mismatch"):
            return
        first_wave_stone += int(quoted["spirit_stones"])
        first_wave_wood += int(quoted["linh_moc"])
        first_wave_ore += int(quoted["thanh_thiet"])
    if not _check(first_wave_stone == 649000
        and first_wave_wood == 46000 and first_wave_ore == 42000,
        "first real material + money four-upgrade spend changed"):
        return
    # Two Mine and two Forest workers, six hours each, produce enough
    # real material to pay four ordinary upgrades; no fake stock injection.
    var mine_output_daily := mine_jobs*int(plan["thanh_thiet"]["yield"])
    var forest_output_daily := forest_jobs*int(plan["linh_moc"]["yield"])
    if not _check(mine_output_daily == 120000
        and forest_output_daily == 96000
        and mine_output_daily >= first_wave_ore
        and forest_output_daily >= first_wave_wood,
        "real ore/wood supply cannot cover one staged upgrade wave"):
        return
    for index in [0,1]:
        var row: Dictionary = all_rows[index]
        var realm := int(row["realm"])
        var rate := int(row["lt2_per_minute"])
        var wage_floor := int(row["w2_min_wage_per_job"])
        if not _check(EconomySystem.SX_V55_R12_RATES[realm]["gross_per_minute"] == rate
            and EconomySystem.SX_V55_R12_RATES[realm]["wage_per_job"] == wage_floor,
            "coded pilot rate drifts from 30-stage workbook"):
            return
        var daily_mine_gross := site_min*rate
        var daily_forest_gross := site_min*rate
        var daily_field_gross := site_min*rate
        var gross := daily_mine_gross+daily_forest_gross+daily_field_gross
        var taxes := daily_mine_gross*70/100+daily_forest_gross*30/100 \
            +daily_field_gross*40/100
        # V5.5-D W2 is a FLOOR; for 60/90min real jobs, each LT2
        # gross already exceeds the floor and topup=0, NOT jobs*W2.
        var wage_topup_due := mine_jobs*maxi(wage_floor-rate*int(plan["thanh_thiet"]["cycle_ticks"]),0) \
            +forest_jobs*maxi(wage_floor-rate*int(plan["linh_moc"]["cycle_ticks"]),0) \
            +grain_jobs*maxi(wage_floor-rate*int(plan["linh_coc"]["cycle_ticks"]),0) \
            +herb_jobs*maxi(wage_floor-rate*int(plan["thanh_linh_thao"]["cycle_ticks"]),0)
        var sect_net := taxes-wage_topup_due-seed_cost+npc_max
        var personal_net := gross-taxes+wage_topup_due
        if not _check(gross == 2160*rate and taxes == 1008*rate \
            and wage_topup_due == 0 \
            and gross+npc_max == sect_net+personal_net+seed_cost,
            "gross/W2 floor/T2/seed/NPC conservation violated"):
            return
        var after_one_wave := sect_net-first_wave_stone
        if not _check(after_one_wave > 0 and sect_net > 1000000
            and not state.sect.economy_a_receipts.has("sxv55-work:qa"),
            "source-backed gross too small for real founding upgrade wave"):
            return
        # The original V5.5-D 06_MoPhong720 tab models r1 Field sowing
        # around 240,000 Stones/day, versus current actual 34/day.
        # Source CSV price and cadence are NOT yet reconciled; log this
        # as a hard player-activation blocker, not a guessed crop-price patch.
        for days in [1,7,30]:
            print("SX_V55_R12_TRUE_COST_HOLD realm=",realm,
                " days=",days,
                " gross=",gross*days,
                " tax=",taxes*days,
                " w2_topup=",wage_topup_due*days,
                " current_seed=",seed_cost*days,
                " npc_sale_best_case=",npc_max*days,
                " first_real_upgrade_wave_LTs=",first_wave_stone,
                " first_real_upgrade_wave_wood=",first_wave_wood,
                " first_real_upgrade_wave_ore=",first_wave_ore,
                " sect_surplus_before_upgrades=",sect_net*days,
                " sect_after_one_wave_only=",sect_net*days-first_wave_stone)
    state.sect.economy_a_policy[EconomySystem.SX_V55_R12_POLICY] = false
    if not _check(state.sect.economy_a_receipts.is_empty()
        and state.sect.economy_a_market_units_sold == 0
        and state.validate_invariants().is_empty(),
        "read-only 1/7/30-day simulation mutated a real wallet or receipt"):
        return
    print("SX-V55 R1/R2 ORIGINAL W2 FLOOR, TRUE ×1000 UPGRADE DEBITS, NPC, SEED CASHFLOW: PASS; FIELD SEED RECONCILIATION AND PLAYER ACTIVATION HOLD")
    quit(0)
